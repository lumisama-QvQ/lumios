+#define OFFSCREEN_PHASE_EPSILON (1.0f / 256.0f)
+
+static void
+transform_framebuffer_points (CoglFramebuffer          *framebuffer,
+                              const graphene_point3d_t *points,
+                              graphene_point3d_t       *transformed_points,
+                              int                       n_points)
+{
+  graphene_matrix_t modelview;
+  graphene_matrix_t projection;
+  graphene_matrix_t modelview_projection;
+  float viewport[4];
+  int i;
+
+  cogl_framebuffer_get_modelview_matrix (framebuffer, &modelview);
+  cogl_framebuffer_get_projection_matrix (framebuffer, &projection);
+  cogl_framebuffer_get_viewport4fv (framebuffer, viewport);
+
+  /* The shared transform helper rounds to 1/256ths, which would lose the
+   * framebuffer phase this function needs to preserve.
+   */
+  graphene_matrix_multiply (&modelview,
+                            &projection,
+                            &modelview_projection);
+
+  for (i = 0; i < n_points; i++)
+    {
+      graphene_vec4_t point;
+      graphene_vec4_t transformed_point;
+      float w;
+
+      graphene_vec4_init (&point,
+                          points[i].x,
+                          points[i].y,
+                          points[i].z,
+                          1.0f);
+      graphene_matrix_transform_vec4 (&modelview_projection,
+                                      &point,
+                                      &transformed_point);
+      w = graphene_vec4_get_w (&transformed_point);
+      transformed_points[i].x =
+        ((((graphene_vec4_get_x (&transformed_point) / w) + 1.0f) / 2.0f) *
+         viewport[2]) + viewport[0];
+      transformed_points[i].y =
+        viewport[1] + viewport[3] -
+        ((((graphene_vec4_get_y (&transformed_point) / w) + 1.0f) / 2.0f) *
+         viewport[3]);
+      transformed_points[i].z = 0.0f;
+    }
+}
+
+static gboolean
+get_framebuffer_phase (CoglFramebuffer       *framebuffer,
+                       float                  resource_scale,
+                       const ClutterActorBox *box,
+                       float                 *phase_x,
+                       float                 *phase_y)
+{
+  graphene_matrix_t modelview_projection;
+  const graphene_point3d_t test_points[] = {
+    GRAPHENE_POINT3D_INIT_ZERO,
+    GRAPHENE_POINT3D_INIT (box->x1, box->y1, 0.0f),
+    GRAPHENE_POINT3D_INIT (box->x2, box->y1, 0.0f),
+    GRAPHENE_POINT3D_INIT (box->x1, box->y2, 0.0f),
+    GRAPHENE_POINT3D_INIT (box->x2, box->y2, 0.0f),
+  };
+  graphene_vec4_t homogeneous_points[G_N_ELEMENTS (test_points)];
+  graphene_point3d_t transformed_points[G_N_ELEMENTS (test_points)];
+  graphene_vec4_t transformed_homogeneous_points[G_N_ELEMENTS (test_points)];
+  graphene_matrix_t modelview;
+  graphene_matrix_t projection;
+  float origin_w;
+  int i;
+
+  /* Phase can only be preserved when the complete source box maps to the
+   * expected axis-aligned pixel grid. Checking its corners also prevents a
+   * small per-unit transform error from accumulating across a large actor.
+   */
+  for (i = 0; i < G_N_ELEMENTS (test_points); i++)
+    graphene_vec4_init (&homogeneous_points[i],
+                        test_points[i].x,
+                        test_points[i].y,
+                        test_points[i].z,
+                        1.0f);
+
+  cogl_framebuffer_get_modelview_matrix (framebuffer, &modelview);
+  cogl_framebuffer_get_projection_matrix (framebuffer, &projection);
+  graphene_matrix_multiply (&modelview,
+                            &projection,
+                            &modelview_projection);
+
+  for (i = 0; i < G_N_ELEMENTS (homogeneous_points); i++)
+    graphene_matrix_transform_vec4 (&modelview_projection,
+                                    &homogeneous_points[i],
+                                    &transformed_homogeneous_points[i]);
+
+  origin_w = graphene_vec4_get_w (&transformed_homogeneous_points[0]);
+  for (i = 1; i < G_N_ELEMENTS (transformed_homogeneous_points); i++)
+    {
+      if (!G_APPROX_VALUE (
+            graphene_vec4_get_w (&transformed_homogeneous_points[i]),
+            origin_w,
+            FLT_EPSILON))
+        return FALSE;
+    }
+
+  transform_framebuffer_points (framebuffer,
+                                test_points,
+                                transformed_points,
+                                G_N_ELEMENTS (test_points));
+
+  for (i = 1; i < G_N_ELEMENTS (transformed_points); i++)
+    {
+      if (!G_APPROX_VALUE (
+            transformed_points[i].x - transformed_points[0].x,
+            test_points[i].x * resource_scale,
+            OFFSCREEN_PHASE_EPSILON) ||
+          !G_APPROX_VALUE (
+            transformed_points[i].y - transformed_points[0].y,
+            test_points[i].y * resource_scale,
+            OFFSCREEN_PHASE_EPSILON))
+        return FALSE;
+    }
+
+  *phase_x = transformed_points[0].x - floorf (transformed_points[0].x);
+  *phase_y = transformed_points[0].y - floorf (transformed_points[0].y);
+
+  if (*phase_x < OFFSCREEN_PHASE_EPSILON ||
+      1.0f - *phase_x < OFFSCREEN_PHASE_EPSILON)
+    *phase_x = 0.0f;
+  if (*phase_y < OFFSCREEN_PHASE_EPSILON ||
+      1.0f - *phase_y < OFFSCREEN_PHASE_EPSILON)
+    *phase_y = 0.0f;
+
+  return TRUE;
+}
+
+static gboolean
+phases_equal (float phase1,
+              float phase2)
+{
+  float delta;
+
+  delta = phase1 - phase2;
+  delta -= roundf (delta);
+  return fabsf (delta) < OFFSCREEN_PHASE_EPSILON;
+}
