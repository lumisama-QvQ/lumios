 static void
+get_sample_size (MetaShapedTexture *stex,
+                 int               *sample_width,
+                 int               *sample_height)
+{
+  if (stex->has_viewport_src_rect)
+    {
+      *sample_width = (int) (stex->viewport_src_rect.size.width *
+                             stex->buffer_scale);
+      *sample_height = (int) (stex->viewport_src_rect.size.height *
+                              stex->buffer_scale);
+    }
+  else
+    {
+      *sample_width = meta_multi_texture_get_width (stex->texture);
+      *sample_height = meta_multi_texture_get_height (stex->texture);
+    }
+
+  if (mtk_monitor_transform_is_rotated (stex->transform))
+    flip_ints (sample_width, sample_height);
