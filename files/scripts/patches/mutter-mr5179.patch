 }
 
 static void
+transform_point (const graphene_matrix_t *matrix,
+                 float                    x,
+                 float                    y,
+                 graphene_point3d_t      *point)
+{
+  graphene_matrix_transform_point3d (
+    matrix,
+    &GRAPHENE_POINT3D_INIT (x, y, 0.0f),
+    point);
+}
+
+static gboolean
+meta_surface_actor_may_use_mipmaps (MetaSurfaceActor  *surface_actor,
+                                    MetaShapedTexture *texture)
+{
+  const float scale_epsilon = 1.0f / 256.0f;
+  ClutterActor *actor = CLUTTER_ACTOR (surface_actor);
+  ClutterActor *stage = clutter_actor_get_stage (actor);
+  graphene_matrix_t actor_to_stage;
+  graphene_point3d_t origin;
+  graphene_point3d_t x_basis;
+  graphene_point3d_t y_basis;
+  float actor_x_scale;
+  float actor_y_scale;
+  float x_scale_unit;
+  float y_scale_unit;
+  GList *l;
+
+  if (!meta_shaped_texture_can_use_mipmaps (texture))
+    return FALSE;
+
+  if (!stage ||
+      clutter_actor_has_mapped_clones (actor) ||
+      clutter_actor_is_in_clone_paint (actor))
+    return TRUE;
+
+  if (!meta_shaped_texture_get_mipmap_scale_units (texture,
+                                                   &x_scale_unit,
+                                                   &y_scale_unit))
+    return TRUE;
+
+  clutter_actor_get_relative_transformation_matrix (actor,
+                                                    stage,
+                                                    &actor_to_stage);
+  if (!graphene_matrix_is_2d (&actor_to_stage))
+    return TRUE;
+
+  transform_point (&actor_to_stage, 0.0f, 0.0f, &origin);
+  transform_point (&actor_to_stage, 1.0f, 0.0f, &x_basis);
+  transform_point (&actor_to_stage, 0.0f, 1.0f, &y_basis);
+
+  /* Painting considers signed scales when choosing mipmaps. Fail closed for
+   * reflections rather than making a different decision based on magnitude.
+   */
+  if (!isfinite (origin.x) ||
+      !isfinite (origin.y) ||
+      !isfinite (x_basis.x) ||
+      !isfinite (x_basis.y) ||
+      !isfinite (y_basis.x) ||
+      !isfinite (y_basis.y) ||
+      fabsf (x_basis.y - origin.y) > scale_epsilon ||
+      fabsf (y_basis.x - origin.x) > scale_epsilon ||
+      x_basis.x < origin.x ||
+      y_basis.y < origin.y)
+    return TRUE;
+
+  actor_x_scale = fabsf (x_basis.x - origin.x);
+  actor_y_scale = fabsf (y_basis.y - origin.y);
+
+  l = clutter_actor_peek_stage_views (actor);
+  if (!l)
+    return TRUE;
+
+  for (; l; l = l->next)
+    {
+      ClutterStageView *view = l->data;
+      float view_scale = clutter_stage_view_get_scale (view);
+      float x_scale;
+      float y_scale;
+
+      x_scale = MAX (0.0f,
+                     actor_x_scale * view_scale * x_scale_unit -
+                     scale_epsilon);
+      y_scale = MAX (0.0f,
+                     actor_y_scale * view_scale * y_scale_unit -
+                     scale_epsilon);
+
+      if (meta_shaped_texture_should_use_mipmaps (texture,
+                                                  x_scale,
+                                                  y_scale))
+        return TRUE;
+    }
+
+  return FALSE;
+}
