#!/usr/bin/env bash
# 注释 fstab 的 / 条目，避免 systemd 按它重挂载根；rootflags 由镜像的 kargs 注入。
set -euo pipefail

if grep -qE '^[^#].*[[:space:]]/[[:space:]]+btrfs[[:space:]]' /etc/fstab; then
  sed -i -E 's|^([^#].*[[:space:]]/[[:space:]]+btrfs[[:space:]].*)$|# \1 # disabled by lumios|' /etc/fstab
  systemctl daemon-reload
  echo "commented out root btrfs entry in /etc/fstab"
fi
