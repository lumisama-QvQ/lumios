# app 的模板（内嵌在 clash-verge-service-install 里）写死 After=network-online.target；
# drop-in 只能给依赖做加法，故整份覆盖。app 重装服务时会覆盖本文件。
[Unit]
Description=Clash Verge Service helps to launch Clash Core.
After=nftables.service iptables.service

[Service]
Type=simple
ExecStart=/usr/bin/clash-verge-service
Restart=always
RestartSec=5
RuntimeDirectory=clash-verge-service
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
